from scipy.stats import expon

#the parameter represents the rate of events occuring per unit of time
lambda_value = 0.1 # 1 customer / 10mins

lambda_inv = expon(scale = 1/lambda_value)

pc = lambda_inv.cdf(5)

print(f"The probability that the next customer will arrive within the next 5 minutes is {pc:.2f}")





print(f"The probability an employee taking a break is {1 - lambda_inv.cdf(15): .2f}")








from scipy.stats import norm

mean = 150 #g 
std = 10

norm_dist = norm(loc = mean, scale = std) print(f"The probability that its weight is between 140 and 160 grams is {norm_dist.cdf(160) - norm_dist.cdf(140): .2f}")











