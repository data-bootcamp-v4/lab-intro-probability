# =====================================
# Lab | Intro to Probability
# =====================================

import numpy as np
from scipy.stats import binom, poisson, expon, norm

# -------------------------------------
# Challenge 1 – Ironhack Airlines
# -------------------------------------

n = 460          # tickets sold
p = 0.97         # probability a passenger shows up
seats = 450      # available seats

probability_airline = binom.cdf(seats, n, p)
print("Challenge 1 – Probability all passengers get a seat:", probability_airline)

# -------------------------------------
# Challenge 2 – Ironhack Call Center
# -------------------------------------

p = 0.3  # probability of success per attempt

probability_call_center = (1 - p) ** 2
print("Challenge 2 – Probability at least 3 attempts needed:", probability_call_center)

# -------------------------------------
# Challenge 3 – Ironhack Website
# -------------------------------------

lambda_visits = 500  # average visits per hour

# Probability overwhelmed in one hour
probability_overwhelmed_hour = 1 - poisson.cdf(550, lambda_visits)
print("Challenge 3 – Probability overwhelmed in one hour:", probability_overwhelmed_hour)

# Probability overwhelmed at least once in 24 hours
prob_safe_hour = poisson.cdf(550, lambda_visits)
probability_overwhelmed_24h = 1 - (prob_safe_hour ** 24)
print("Challenge 3 – Probability overwhelmed in 24 hours:", probability_overwhelmed_24h)

# -------------------------------------
# Challenge 4 – Ironhack Helpdesk
# -------------------------------------

lambda_rate = 1 / 10  # one customer every 10 minutes

# Arrival within 5 minutes
probability_arrival_5min = expon.cdf(5, scale=1/lambda_rate)
print("Challenge 4 – Probability next customer arrives within 5 minutes:", probability_arrival_5min)

# No arrival for 15 minutes (break)
probability_break = 1 - expon.cdf(15, scale=1/lambda_rate)
print("Challenge 4 – Probability employee can take a break:", probability_break)

# -------------------------------------
# Challenge 5 – Bird Weights
# -------------------------------------

mean = 150
std = 10

probability_bird_weight = norm.cdf(160, mean, std) - norm.cdf(140, mean, std)
print("Challenge 5 – Probability bird weighs between 140g and 160g:", probability_bird_weight)

# -------------------------------------
# Challenge 6 – Electronic Component
# -------------------------------------

mean_lifetime = 50
lambda_rate = 1 / mean_lifetime

probability_failure_30h = expon.cdf(30, scale=1/lambda_rate)
print("Challenge 6 – Probability component fails within 30 hours:", probability_failure_30h)
